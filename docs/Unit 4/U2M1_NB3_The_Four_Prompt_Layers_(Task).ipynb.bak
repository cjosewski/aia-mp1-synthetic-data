        "# ==========================================================================\n",
        "# 🏗️ Exercise 2: Send the Same Question With 1, 2 and 3 Layers\n",
        "# ==========================================================================\n",
        "\n",
        "# Make sure the Setup cell ran first (it creates ask() and CUSTOMER_MESSAGE)\n",
        "assert \"ask\" in globals(), \"Run the Setup cell at the top of the notebook first.\"\n",
        "\n",
        "import re         # re: to count sentences\n",
        "import textwrap   # textwrap: wraps long lines so the answers are easy to read\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 1: Layer 3, the harness system prompt\n",
        "# ==========================================================================\n",
        "# These are the coding agent's instructions from Exercise 1. They were written for coding jobs,\n",
        "# not for a bank, so watch what they do to the answer.\n",
        "HARNESS_RULES = (\n",
        "    \"You are a bank assistant working in a bank. Read files before editing them. \"\n",
        "    \"Run the tests after a change. Ask before running anything destructive.\"\n",
        ")\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 2: Layer 2, the user system prompt: YOUR rules for the bank's assistant\n",
        "# ==========================================================================\n",
        "# Two or three sentences: who the assistant is, how it talks, what it may and may not say.\n",
        "# (Python joins strings that sit next to each other inside brackets into one long string.)\n",
        "# TODO 1: Write your own user system prompt in 2 or 3 sentences: who the assistant is, how it talks,\n",
        "# and what it may and may not say. Example start: \"You are a bank's support assistant. ...\"\n",
        "BANK_RULES = ___  # <-- Fill in the blank (a string)\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 3: Build the three versions of the message list\n",
        "# ==========================================================================\n",
        "# Each version is a list of messages. The model reads them top to bottom,\n",
        "# so the rules go first and the customer's question goes last. Each version adds one layer.\n",
        "\n",
        "# Version A: only the customer's question (layer 1)\n",
        "version_a = [\n",
        "    {\"role\": \"user\", \"content\": CUSTOMER_MESSAGE},                                  # layer 1\n",
        "]\n",
        "# Version B: your rules in front of the question (layers 2 + 1)\n",
        "version_b = [\n",
        "    # TODO 2: Put your rules in front of the customer's message, as a system message\n",
        "    {\"role\": ___, \"content\": ___},  # <-- Fill in the blanks (layer 2)\n",
        "    {\"role\": \"user\", \"content\": CUSTOMER_MESSAGE},                                  # layer 1\n",
        "]\n",
        "# Version C: the harness's rules, then your rules, in one system message (layers 3 + 2 + 1)\n",
        "version_c = [\n",
        "    # TODO 3: Put the harness rules AND your rules in one system message (harness first, then a blank line)\n",
        "    {\"role\": \"system\", \"content\": ___ + \"\\n\\n\" + ___},  # <-- Fill in the blanks (layers 3 + 2)\n",
        "    {\"role\": \"user\", \"content\": CUSTOMER_MESSAGE},                                  # layer 1\n",
        "]\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 4: Ask the same model the same question three times, one version each\n",
        "# ==========================================================================\n",
        "# We keep each reply and its token count in a dictionary, to compare them in Step 5.\n",
        "results = {}\n",
        "for name, messages in [(\"A · layer 1\", version_a), (\"B · layers 2 + 1\", version_b), (\"C · layers 3 + 2 + 1\", version_c)]:\n",
        "    print(\"=\" * 70)\n",
        "    print(f\"🧅 VERSION {name}\")\n",
        "    print(\"=\" * 70)\n",
        "    # TODO 4: Send this version's messages with the ask() helper from the Setup cell. It returns (reply, tokens_in)\n",
        "    reply, tokens_in = ask(___)  # <-- Fill in the blank\n",
        "    results[name] = {\"reply\": reply, \"tokens_in\": tokens_in}\n",
        "    print(textwrap.fill(reply, width=100))\n",
        "    print()\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 5: Compare the three answers\n",
        "# ==========================================================================\n",
        "# For each version: tokens read, length of the answer, and any coding words that slipped into a bank answer.\n",
        "print(\"=\" * 70)\n",
        "print(\"📊 SIDE BY SIDE\")\n",
        "print(\"=\" * 70)\n",
        "coding_words = [\"file\", \"code\", \"test\", \"terminal\", \"repository\", \"command\", \"pytest\"]\n",
        "for name, result in results.items():\n",
        "    words = len(result[\"reply\"].split())   # split() cuts the text at spaces, so this counts words\n",
        "    leaked = [word for word in coding_words if word in result[\"reply\"].lower()]\n",
        "    print(f\"{name:<22} tokens in: {result['tokens_in']:>4} · answer: {words:>3} words · coding words: {leaked or 'none'}\")\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 6: Self-check\n",
        "# ==========================================================================\n",
        "print()\n",
        "print(\"=\" * 70)\n",
        "print(\"✅ SELF-CHECK\")\n",
        "print(\"=\" * 70)\n",
        "# Split your rules at every . ! or ? and keep the non-empty pieces: that is the number of sentences\n",
        "sentences = [s for s in re.split(r\"[.!?]+\", str(BANK_RULES)) if s.strip()]\n",
        "print(f\"{'✅' if 2 <= len(sentences) <= 3 else '❌'} BANK_RULES has {len(sentences)} sentences (2 or 3 wanted)\")\n",
        "tokens = [result[\"tokens_in\"] for result in results.values()]\n",
        "print(\"✅ Tokens in grow A < B < C: every layer is paid for on every call\" if tokens[0] < tokens[1] < tokens[2] else f\"❌ Expected tokens in to grow, got {tokens}\")\n",
        "print()\n",
        "print(\"🧠 Same model, same question, three answers. Only the layers in front of the customer's message changed.\")"
      ]
