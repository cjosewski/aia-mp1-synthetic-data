        "# ==========================================================================\n",
        "# 🧩 Exercise 4: Sort Snippets by Layer and Steps by Model or Code\n",
        "# ==========================================================================\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 1: Which layer is each snippet?\n",
        "# ==========================================================================\n",
        "# 1 user prompt · 2 user system prompt · 3 harness system prompt · 4 planner prompt\n",
        "snippet_layers = {\n",
        "    # TODO 1: Write the layer number (1, 2, 3 or 4) for each snippet. Ask: who would write it, and how often does it change?\n",
        "    \"Never show a full card number.\": ___,  # <-- Fill in the blank\n",
        "    \"Why was my card declined?\": ___,  # <-- Fill in the blank\n",
        "    \"Step 1: get today's withdrawals. Step 2: compare to the limit.\": ___,  # <-- Fill in the blank\n",
        "    \"When a tool fails, report the error and try once more.\": ___,  # <-- Fill in the blank\n",
        "}\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 2: In this notebook, who did it: \"model\" or \"code\"?\n",
        "# ==========================================================================\n",
        "# Ask yourself: was this writing text (the model), or doing something (code)?\n",
        "who_did_it = {\n",
        "    # TODO 2: Replace each ___ with \"model\" or \"code\"\n",
        "    \"Put the bank rules in front of the customer's message\": ___,  # <-- Fill in the blank\n",
        "    \"Wrote the 3-step plan\": ___,  # <-- Fill in the blank\n",
        "    \"Put the plan back in front of the model\": ___,  # <-- Fill in the blank\n",
        "    \"Wrote the answer the customer reads\": ___,  # <-- Fill in the blank\n",
        "    \"Counted the tokens and added up the bill\": ___,  # <-- Fill in the blank\n",
        "}\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 3: Your closing sentence\n",
        "# ==========================================================================\n",
        "# This one is not checked, but write it: it is the main idea of the notebook.\n",
        "# TODO 3: In one sentence: in these calls, what did the model do, and what did the software around it do?\n",
        "my_sentence = ___  # <-- Fill in the blank (a string)\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 4: Check your answers\n",
        "# ==========================================================================\n",
        "CORRECT_LAYERS = {\n",
        "    \"Never show a full card number.\": 2,\n",
        "    \"Why was my card declined?\": 1,\n",
        "    \"Step 1: get today's withdrawals. Step 2: compare to the limit.\": 4,\n",
        "    \"When a tool fails, report the error and try once more.\": 3,\n",
        "}\n",
        "# A short reason for each layer, printed next to a correct answer\n",
        "WHY = {\n",
        "    2: \"a standing rule the bank's builders wrote, sent on every call\",\n",
        "    1: \"the customer, typing right now\",\n",
        "    4: \"the model planning its own steps\",\n",
        "    3: \"about how agents handle tools in general: the harness's business\",\n",
        "}\n",
        "CORRECT_WHO = {\n",
        "    \"Put the bank rules in front of the customer's message\": \"code\",\n",
        "    \"Wrote the 3-step plan\": \"model\",\n",
        "    \"Put the plan back in front of the model\": \"code\",\n",
        "    \"Wrote the answer the customer reads\": \"model\",\n",
        "    \"Counted the tokens and added up the bill\": \"code\",\n",
        "}\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"✅ SELF-CHECK\")\n",
        "print(\"=\" * 70)\n",
        "score = 0\n",
        "for snippet, layer in snippet_layers.items():\n",
        "    right = layer == CORRECT_LAYERS[snippet]\n",
        "    score += right   # True counts as 1, False as 0\n",
        "    print(f\"{'✅' if right else '❌'} \\\"{snippet}\\\" → layer {layer}\" + (f\"  ({WHY[layer]})\" if right else \"\"))\n",
        "print()\n",
        "for thing, answer in who_did_it.items():\n",
        "    # .strip().lower() ignores extra spaces and capital letters, so \"Code \" also counts as \"code\"\n",
        "    right = str(answer).strip().lower() == CORRECT_WHO[thing]\n",
        "    score += right\n",
        "    print(f\"{'✅' if right else '❌'} {thing} → {answer}\")\n",
        "print()\n",
