      "source": [
        "# ==========================================================================\n",
        "# 🔎 Exercise 1: Label Each Message in a Transcript With Its Layer\n",
        "# ==========================================================================\n",
        "\n",
        "import tiktoken   # tiktoken: cuts text into tokens\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 1: The transcript: six bubbles, in the order the model reads them\n",
        "# ==========================================================================\n",
        "# Each bubble is a dictionary: its number, its role, a short label, and its text.\n",
        "TRANSCRIPT = [\n",
        "    {\"bubble\": 1, \"role\": \"system\", \"label\": \"harness instructions\",\n",
        "     \"text\": \"You are a coding agent working in the user's terminal. Read files before editing them. \"\n",
        "             \"Run the tests after a change. Ask before running anything destructive.\"},\n",
        "    {\"bubble\": 2, \"role\": \"system\", \"label\": \"CLAUDE.md (project file)\",\n",
        "     \"text\": \"Bank support bot. Python 3.12. Run tests with pytest. Never print full card numbers.\"},\n",
        "    {\"bubble\": 3, \"role\": \"user\", \"label\": \"you\",\n",
        "     \"text\": \"Add a reply for declined ATM withdrawals that explains the daily limit.\"},\n",
        "    {\"bubble\": 4, \"role\": \"assistant\", \"label\": \"agent (plan)\",\n",
        "     \"text\": \"Plan: 1) find the intent handler 2) add a daily-limit reply 3) add a test using a sample customer message 4) run pytest\"},\n",
        "    {\"bubble\": 5, \"role\": \"tool\", \"label\": \"tool call and result\",\n",
        "     \"text\": \"read_file('bot/intents.py') → 214 lines\"},\n",
        "    {\"bubble\": 6, \"role\": \"assistant\", \"label\": \"agent\",\n",
        "     \"text\": \"Done. Added the reply and 1 test. 13 tests passed.\"},\n",
        "]\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"📜 THE TRANSCRIPT (everything here is read by the model)\")\n",
        "print(\"=\" * 70)\n",
        "for bubble in TRANSCRIPT:\n",
        "    # :<9 pads the role to 9 characters, so the labels line up in a column\n",
        "    print(f\"[{bubble['bubble']}] {bubble['role']:<9} · {bubble['label']}\")\n",
        "    print(f\"    {bubble['text']}\")\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 2: Label each bubble with its layer\n",
        "# ==========================================================================\n",
        "# A dictionary from bubble number to layer: 1, 2, 3, 4, or 0 for \"not a prompt layer\".\n",
        "# Ask for each one: who wrote it, and how often does it change?\n",
        "my_layers = {\n",
        "    # TODO 1: For each bubble number, write its layer (1, 2, 3, 4) or 0 if it is not a prompt layer\n",
        "    1: ___,  # <-- Fill in the blank (harness instructions)\n",
        "    2: ___,  # <-- Fill in the blank (the project file the team wrote)\n",
        "    3: ___,  # <-- Fill in the blank (the line you typed)\n",
        "    4: ___,  # <-- Fill in the blank (the plan the agent wrote for itself)\n",
        "    5: ___,  # <-- Fill in the blank (a tool result)\n",
        "    6: ___,  # <-- Fill in the blank (the agent's final answer)\n",
        "}\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 3: Find three harness parts in the same transcript\n",
        "# ==========================================================================\n",
        "# Answer each one with a bubble number.\n",
        "# TODO 2: Which bubble shows a TOOL being called?\n",
        "tools_bubble = ___  # <-- Fill in the blank\n",
        "# TODO 3: Which bubble is MEMORY loaded from a file the agent reads every session?\n",
        "memory_bubble = ___  # <-- Fill in the blank\n",
        "# TODO 4: Which bubble proves a CHECK ran (the tests)?\n",
        "check_bubble = ___  # <-- Fill in the blank\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 4: Count the tokens in each bubble\n",
        "# ==========================================================================\n",
        "# encoder.encode(text) gives the list of tokens; len() of that list is the token count.\n",
        "# The {...: ... for ... in ...} form builds a dictionary in one line: bubble number → token count.\n",
        "encoder = tiktoken.get_encoding(\"o200k_base\")\n",
        "# TODO 5: For each bubble, count its tokens. Hint: len(encoder.encode(text))\n",
        "token_counts = {bubble[\"bubble\"]: ___ for bubble in TRANSCRIPT}  # <-- Fill in the blank\n",
        "total_tokens = sum(token_counts.values())\n",
        "\n",
        "print()\n",
        "print(\"=\" * 70)\n",
        "print(\"📏 TOKENS PER BUBBLE\")\n",
        "print(\"=\" * 70)\n",
        "for number, count in token_counts.items():\n",
        "    bar = \"█\" * count   # one block per token, to draw a simple bar chart\n",
        "    print(f\"[{number}] {count:>3} tokens {bar}\")\n",
        "typed_share = token_counts[3] / total_tokens * 100   # bubble 3 is the line you typed\n",
        "print(f\"\\nYou typed {token_counts[3]} of the {total_tokens} tokens the model read: {typed_share:.0f}%.\")\n",
        "print(\"In a real coding agent the harness instructions alone are thousands of tokens, so your line is a thin sliver.\")\n",
        "\n",
        "# ==========================================================================\n",
        "# Step 5: Self-check\n",
        "# ==========================================================================\n",
        "LAYER_NAMES = {0: \"not a prompt layer\", 1: \"user prompt\", 2: \"user system prompt\", 3: \"harness system prompt\", 4: \"planner prompt\"}\n",
        "CORRECT_LAYERS = {1: 3, 2: 2, 3: 1, 4: 4, 5: 0, 6: 0}\n",
        "print()\n",
        "print(\"=\" * 70)\n",
        "print(\"✅ SELF-CHECK\")\n",
        "print(\"=\" * 70)\n",
        "for number, layer in my_layers.items():\n",
        "    right = layer == CORRECT_LAYERS[number]\n",
        "    print(f\"{'✅' if right else '❌'} Bubble {number}: {layer} ({LAYER_NAMES.get(layer, '?')})\")\n",
        "print(f\"{'✅' if tools_bubble == 5 else '❌'} Tools box: bubble {tools_bubble}\")\n",
        "print(f\"{'✅' if memory_bubble == 2 else '❌'} Memory box: bubble {memory_bubble}\")\n",
        "print(f\"{'✅' if check_bubble == 6 else '❌'} A check ran: bubble {check_bubble}\")\n",
        "print(f\"{'✅' if token_counts[3] == 13 else '❌'} Your typed line is {token_counts[3]} tokens (13 expected)\")\n",
        "print()\n",
        "print(\"🧠 You wrote ONE of these six bubbles. The harness, the team and the model wrote the rest.\")"
      ]
    },
